# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit secrets.

# Path to the SQLite database file (relative to the project root).
DATABASE_PATH=./data/morning-paper.db

# LLM used for interest profiles, story summaries and the daily recap.
#   anthropic  Claude via api.anthropic.com   (default model: claude-sonnet-5-5)
#   openai     OpenAI chat completions        (default model: gpt-4.1-mini)
#   mock       no LLM: offline heuristics (keyword profile, extractive summaries)
# If the key is missing or a call fails, the app falls back to the heuristics automatically.
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional: override the provider's default model.
LLM_MODEL=
