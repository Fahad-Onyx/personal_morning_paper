# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit secrets.

# Path to the SQLite database file (relative to the project root).
DATABASE_PATH=./data/morning-paper.db

# LLM provider used for interest profiles, summaries, ranking help and recaps.
# Supported (from Phase 2): "anthropic" | "openai" | "mock"
# "mock" needs no key and returns deterministic fake output, which is useful offline.
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional: override the provider's default model.
LLM_MODEL=
